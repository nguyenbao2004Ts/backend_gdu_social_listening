// GDU Social Listening — PostgreSQL schema `dev`
// Generate client: python -m prisma generate
// Docs: https://prisma-client-py.readthedocs.io/

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  previewFeatures      = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dev"]
}

model AppUser {
  id         BigInt    @id @default(autoincrement())
  username   String    @unique @db.VarChar(100)
  password   String    @db.VarChar(255)
  role       String    @db.VarChar(50)
  firstName  String?   @map("first_name") @db.VarChar(100)
  lastName   String?   @map("last_name") @db.VarChar(100)
  fullName   String?   @map("full_name") @db.VarChar(255)
  sdt        String?   @db.VarChar(20)
  avatarUrl  String?   @map("avatar_url")
  sex        String?   @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiLogs ApiLog[]

  @@map("APP_USER")
  @@schema("dev")
}

model Keyword {
  id        BigInt   @id @default(autoincrement())
  keyword   String   @db.VarChar(255)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("KEYWORDS")
  @@schema("dev")
}

model Source {
  id          BigInt       @id @default(autoincrement())
  name        String       @db.VarChar(255)
  type        String       @db.VarChar(100)
  socialPosts SocialPost[]

  @@map("SOURCES")
  @@schema("dev")
}

model SocialPost {
  id               BigInt    @id @default(autoincrement())
  sourceId         BigInt    @map("source_id")
  keyword          String?   @db.VarChar(255)
  title            String?
  content          String?
  author           String?   @db.VarChar(255)
  url              String?
  interactionCount Int       @default(0) @map("interaction_count")
  postTime         DateTime? @map("post_time") @db.Timestamptz(6)
  crawlTime        DateTime  @default(now()) @map("crawl_time") @db.Timestamptz(6)

  source   Source    @relation(fields: [sourceId], references: [id])
  comments Comment[]

  @@index([sourceId])
  @@index([keyword])
  @@map("SOCIAL_POSTS")
  @@schema("dev")
}

model Comment {
  id          BigInt    @id @default(autoincrement())
  postId      BigInt    @map("post_id")
  author      String?   @db.VarChar(255)
  content     String?
  createdTime DateTime? @map("created_time") @db.Timestamptz(6)

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("COMMENTS")
  @@schema("dev")
}

model GoogleReview {
  id            BigInt    @id @default(autoincrement())
  reviewer      String?   @db.VarChar(255)
  rating        Int?
  reviewContent String?   @map("review_content")
  reviewTime    DateTime? @map("review_time") @db.Timestamptz(6)
  imageUrl      String?   @map("image_url")

  @@map("GOOGLE_REVIEWS")
  @@schema("dev")
}

model CrawlLog {
  id           BigInt    @id @default(autoincrement())
  sourceName   String    @map("source_name") @db.VarChar(255)
  status       String    @db.VarChar(50)
  totalRecords Int       @default(0) @map("total_records")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  @@map("CRAWL_LOGS")
  @@schema("dev")
}

model ApiLog {
  id             BigInt    @id @default(autoincrement())
  nameLog        String?   @map("name_log") @db.VarChar(255)
  requestMethod  String?   @map("request_method") @db.VarChar(10)
  requestUrl     String?   @map("request_url") @db.VarChar(255)
  input          String?
  output         String?
  userCreate     BigInt?   @map("user_create")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  statusCode     Int?      @map("status_code")
  executionTime  String?   @map("execution_time") @db.VarChar(50)

  user AppUser? @relation(fields: [userCreate], references: [id], onDelete: SetNull)

  @@index([userCreate])
  @@map("API_LOGS")
  @@schema("dev")
}
