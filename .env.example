# PostgreSQL — database gdu_social_listening, schema dev
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@HOSTNAME:PORT/DATABASE_NAME
DB_SCHEMA=dev

# FastAPI
APP_NAME=GDU Social Listening API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (đổi secret khi deploy)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_HOURS=24
